# Synchronisation Dexie Cloud désactivée par défaut pour un environnement local neuf.
VITE_ENABLE_SYNC_PROTOTYPE=false

# URL publique créée par `npx dexie-cloud create`.
# Ne jamais placer dexie-cloud.key, client_id ou client_secret dans une variable VITE_*.
VITE_DEXIE_CLOUD_DATABASE_URL=

# Pesées réelles. Désactivées par défaut dans un environnement local neuf.
VITE_ENABLE_REAL_WEIGHT_SYNC=false

# Activités sportives réelles. Synchronisation manuelle.
VITE_ENABLE_REAL_ACTIVITY_SYNC=false

# Objectifs sportifs. Synchronisation manuelle.
VITE_ENABLE_REAL_GOAL_SYNC=false

# Musculation : exercices personnalisés, modèles, séances et séries.
VITE_ENABLE_REAL_STRENGTH_SYNC=false

# Journal nutritionnel : repas, entrées, objectifs quotidiens et statuts.
VITE_ENABLE_REAL_NUTRITION_JOURNAL_SYNC=false
# Bibliothèque nutritionnelle : produits utiles, recettes et repas favoris.
VITE_ENABLE_REAL_NUTRITION_LIBRARY_SYNC=false

# Suivi nutritionnel : bilans hebdomadaires et ajustements caloriques acceptés.
VITE_ENABLE_REAL_NUTRITION_TRACKING_SYNC=false

# Profil, objectifs généraux, paramètres de calcul, tableau de bord et modèles d’endurance.
VITE_ENABLE_REAL_ACCOUNT_PREFERENCES_SYNC=false

# Badges, thèmes visuels, missions hebdomadaires et rappels.
VITE_ENABLE_REAL_REWARDS_ROUTINES_SYNC=false

# Cloud social réel : identités publiques, demandes d’amis, permissions et snapshots filtrés.
# Valeur locale et production prudente par défaut : false.
# Pour une validation contrôlée Cloudflare Preview, définir explicitement true côté hébergeur.
VITE_ENABLE_REAL_SOCIAL_CLOUD=false

# Outils de laboratoire (pesées fictives, C4 manuel, diagnostic détaillé).
# À conserver à false dans un déploiement utilisateur.
VITE_ENABLE_SYNC_DIAGNOSTICS=false

# IA photo nutrition : endpoint du proxy backend sécurisé.
# Ne jamais placer de clé Gemini, OpenAI, Mistral, Anthropic ou autre secret dans une variable VITE_*.
# La PWA envoie uniquement la photo au proxy après consentement explicite de l’utilisateur.
VITE_PHOTO_NUTRITION_AI_ENDPOINT=
VITE_PHOTO_NUTRITION_AI_TIMEOUT_MS=15000


# Proxy IA photo Gemini Free Tier — variables serveur uniquement.
# À définir dans le terminal du proxy local ou chez l’hébergeur, jamais dans une variable VITE_*.
# Sur le Free Tier Gemini, les contenus transmis peuvent être utilisés par Google pour améliorer ses produits.
PHOTO_NUTRITION_AI_PROVIDER=gemini
PHOTO_NUTRITION_AI_API_KEY=
PHOTO_NUTRITION_AI_MODEL=gemini-2.5-flash-lite
PHOTO_NUTRITION_AI_PROXY_PORT=8787


# Annuaire social serveur F2 : résolution exacte de handles entre vrais comptes.
# Endpoint public du front. Aucun secret ne doit être placé ici.
# En Cloudflare Pages Preview/Production : /api/social-directory
VITE_SOCIAL_DIRECTORY_ENDPOINT=

# Binding serveur Cloudflare D1 à configurer dans Workers & Pages > Settings > Bindings.
# Ce n’est pas une variable texte locale VITE_* : créer un binding D1 nommé SOCIAL_DIRECTORY_DB.
SOCIAL_DIRECTORY_DB=
VITE_SOCIAL_FRIEND_REQUESTS_ENDPOINT=/api/social-friend-requests

# Endpoint serveur Pages Functions pour amitiés et permissions sociales D1.
VITE_SOCIAL_FRIENDS_ENDPOINT=/api/social-friends
